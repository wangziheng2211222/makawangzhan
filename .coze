[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} npx next start -p ${DEPLOY_RUN_PORT:-5000}"]

[deploy]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} npx next start -p ${DEPLOY_RUN_PORT:-5000}"]