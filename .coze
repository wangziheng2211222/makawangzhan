[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "pnpm run start --hostname 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]

[deploy]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "pnpm run start --hostname 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]
