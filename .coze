[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} node_modules/.bin/next start -p ${DEPLOY_RUN_PORT:-5000} -H 0.0.0.0"]

[deploy]
build = ["bash", "-c", "pnpm install && pnpm run build"]
run = ["sh", "-c", "PORT=${DEPLOY_RUN_PORT:-5000} node_modules/.bin/next start -p ${DEPLOY_RUN_PORT:-5000} -H 0.0.0.0"]