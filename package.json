{
  "name": "maka-town-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:preview": "pnpm install && pnpm run build",
    "start": "next start --hostname 0.0.0.0 --port ${DEPLOY_RUN_PORT:-${PORT:-3000}}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:journey": "node --no-warnings --experimental-strip-types scripts/check-journey-timeline.mjs",
    "test:story-scenes": "node scripts/check-story-scenes-workflow.mjs",
    "media:generate": "node scripts/media-generate.mjs",
    "media:generate:production": "node scripts/generate-production-videos.mjs",
    "media:generate:stories": "node scripts/generate-story-scenes.mjs",
    "media:verify:stories": "node scripts/generate-story-scenes.mjs --stage verify"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
